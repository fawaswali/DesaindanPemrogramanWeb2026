{
  "version": 2,
  "builds": [
    {
      "src": "jobsheet-07/*.php",
      "use": "vercel-php@0.7.3"
    },
    {
      "src": "jobsheet-08/index.php",
      "use": "vercel-php@0.7.3"
    },
    {
      "src": "jobsheet-08/kamar/*.php",
      "use": "vercel-php@0.7.3"
    },
    {
      "src": "jobsheet-08/penghuni/*.php",
      "use": "vercel-php@0.7.3"
    },
    {
      "src": "**/*.{html,css,js,png,jpg,svg}",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "/$1"
    }
  ]
}