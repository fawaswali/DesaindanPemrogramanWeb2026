{
  "version": 2,
  "builds": [
    {
      "src": "api/index.php",
      "use": "vercel-php@0.7.3"
    },
    {
      "src": "**/*.*",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "handle": "filesystem"
    },
    {
      "src": "/(jobsheet-.*\\.php.*)",
      "dest": "/api/index.php"
    },
    {
      "src": "/(jobsheet-[^/]+/?)$",
      "dest": "/api/index.php"
    }
  ]
}